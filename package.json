{
  "name": "freechemistryapp",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @chemistry/web dev",
    "build": "pnpm --filter @chemistry/web build",
    "preview": "pnpm --filter @chemistry/web preview",
    "typecheck": "pnpm --filter @chemistry/web exec tsc -b",
    "test": "pnpm --filter @chemistry/web test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/chemistry.git"
  }
}
